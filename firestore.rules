rules_version = '2';
// Reglas de Firestore para ANIMAPP IAEV.
// - horarios/*  : lectura para cualquier cuenta @upsrj.edu.mx verificada.
// - profesores/*: lectura solo para los docentes de "Nuestra Academia".
// - Escritura (admin.html): los docentes de "Nuestra Academia".
// - perfiles/{uid}: la credencial de cada persona; solo su dueño la lee y la edita.
// Si cambia la lista de docentes en ANIMAPP, actualiza también la lista de docente() aquí.
service cloud.firestore {
  match /databases/{database}/documents {
    function upsrj() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@upsrj[.]edu[.]mx$');
    }
    function docente() {
      return upsrj() && request.auth.token.email.lower() in [
        'ezermeno@upsrj.edu.mx',
        'mruiz@upsrj.edu.mx',
        'acarrizalez@upsrj.edu.mx',
        'chernandez@upsrj.edu.mx',
        'ghernandez@upsrj.edu.mx',
        'jzamora@upsrj.edu.mx',
        'iraragon@upsrj.edu.mx',
        'jsalgado@upsrj.edu.mx',
        'vibarra@upsrj.edu.mx'
      ];
    }
    // Administradores: los mismos docentes de "Nuestra Academia".
    function admin() {
      return docente();
    }
    // Incluye las partes de los archivos (subcolección "partes").
    match /horarios/{rest=**} {
      allow read: if upsrj();
      allow write: if admin();
    }
    // Calendario de alumnos: público (lo lee cualquier visitante), lo editan los docentes.
    match /publico/{rest=**} {
      allow read: if true;
      allow write: if admin();
    }
    match /profesores/{rest=**} {
      allow read: if docente();
      allow write: if admin();
    }
    // Credencial de cada persona (foto, nombre, matrícula): solo la lee y edita su dueño.
    match /perfiles/{uid} {
      allow read: if upsrj() && request.auth.uid == uid;
      allow create, update: if upsrj() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'matricula', 'foto', 'correo', 'actualizado'])
        && (!('foto' in request.resource.data) || (request.resource.data.foto is string && request.resource.data.foto.size() < 400000))
        && (!('nombre' in request.resource.data) || (request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80))
        && (!('matricula' in request.resource.data) || (request.resource.data.matricula is string && request.resource.data.matricula.size() <= 20));
      allow delete: if upsrj() && request.auth.uid == uid;
    }
  }
}
